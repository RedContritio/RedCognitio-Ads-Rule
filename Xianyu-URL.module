#!name=闲鱼 广告拦截（需 MITM）
#!desc=清空开屏广告池并清空本地缓存；剔除信息流与搜索结果里的广告卡。需 MITM，Loon 3.5.1+
#!category=广告拦截
#!author=RedContritio
#!homepage=https://github.com/RedContritio/RedCognitio-Ads-Rule
#!version=0.1.0
#!date=2026-10-26 · 0.1.0
#!loon_version=3.5.1(983)
#
# Copyright 2026 RedContritio
# SPDX-License-Identifier: Apache-2.0
#
# 范围：只做去广告。不裁剪推荐内容、不改界面结构——整段推广位（猜你喜欢、购买推荐、
# 播放页推荐、策略位、同城角落、搜索底纹）与圈头/顶栏精简都不在本模块内。

[Argument]
xianyu_enable = switch,true,type=boolean,tag=闲鱼-去广告,desc=清空开屏广告池并剔除信息流、搜索里的广告卡
xianyu_debug = switch,false,type=boolean,tag=闲鱼-调试,desc=记录进入脚本的广告请求

[Rule]
# QUIC 无法 MITM，不拦则本文件全部规则静默失效。
# 闲鱼业务域 goofish.com；mtop 网关为 acs.m.goofish.com / g-acs.m.goofish.com，
# 少量公共接口仍走 acs.m.taobao.com，两套都要覆盖。
AND,((DOMAIN-SUFFIX,goofish.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,taobao.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# ══ 开屏广告池 ══
# mtop.taobao.idlecommerce.splash.ads（2.0，冷/热启同步请求）
# mtop.taobao.idlecommerce.splash.async.ads（1.0，Wi-Fi 预取，写本地缓存）
#
# 只 reject 同步请求会复发：失败分支 requestAsyncSplashAd 会补一次异步预取，
# 把素材写进 SplashAdCacheManager，下次启动由服务端 cacheAdInfo 直接指定播放。
# 社区规则（可莉 FleaMarket_remove_ads）只 reject 同步接口，实测「曾一次有效后复发」。
# 这里改为响应层清池：adMap={} + cacheAdInfo=null + realTimeAd=null，
# 同时把空池写回缓存，adCount()=0 且 getAdapterKey()=null，不进任何 adapter。
# data 保留为对象：客户端 onSuccess 里有 getData().requestId 的取值路径。
response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlecommerce\.splash(?:\.async)?\.ads\//i then response.json.jq("if (.data | type) == \"object\" then .data |= (.adMap = {} | .cacheAdInfo = null | .realTimeAd = null) else . end")

# ══ 信息流广告卡 ══
# 卡片类型在 data.clickParam.args.cardType，广告位为 mamaAD / homeMultiBanner / banner。
# 只剔除广告类型，正常卡片原样保留；不用模板名白名单（接口换模板会把整屏清空）。
response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\//i then response.json.jq("if (.data.sections | type) == \"array\" then .data.sections |= map(select((try (.data.clickParam.args.cardType) catch null) as $ct | $ct != \"mamaAD\" and $ct != \"homeMultiBanner\")) else . end")

response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlehome\.home\.newitem\.page\//i then response.json.jq("if (.data.sections | type) == \"array\" then .data.sections |= map(select((try (.data.clickParam.args.cardType) catch null) as $ct | $ct != \"mamaAD\" and $ct != \"banner\")) else . end")

response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idle\.local\.home\//i then response.json.jq("if (.data.sections | type) == \"array\" then .data.sections |= map(select((try (.template.cardEnum) catch null) != \"ads\")) else . end")

# ══ 搜索广告 ══
# 搜索结果广告带 dislikeFeedback.clickParam.args.bizType == "ad"，同结构的普通结果保留。
response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlemtopsearch\.search\//i then response.json.jq("if (.data.resultList | type) == \"array\" then .data.resultList |= map(select((try (.data.item.main.exContent.dislikeFeedback.clickParam.args.bizType) catch null) != \"ad\")) else . end")

# ══ 明确不做 ══
# 整段推广位 reject：idle.item.recommend.list（猜你喜欢）、idle.item.buy.feeds（购买推荐）、
#   idle.playboy.recommend（播放页推荐）、idle.user.strategy.list（策略位）、
#   idle.local.near.by.corner.info（同城角落）、idlemtopsearch.search.shade（搜索底纹）。
#   拦掉会让整块推荐内容消失，属功能裁剪而非去广告。
# 界面精简：circle.list 圈头白名单、magic.home.page.list 删 topList、search 删 resultPrefixBar。
# mtop.taobao.idlecommerce.adx.bid：三方 SDK 出价入口，拦掉可能退回非竞价瀑布流，广告反而更多。
# mtop.taobao.idlecommerce.game.iaa.ads、rewardad：用户主动触发的激励视频。
# mtop.alimama.zz.ad.get、munion.taosdk：阿里妈妈推荐位取数，字段结构未证实。
# 阿里系埋点 adash / adashx：拦掉不影响展示。

[Script]
request if ${xianyu_debug} == true && ${url} ~= /(?:idlecommerce|mtop\.idle)\.(?:adx|splash|ad|game)/i then script("https://raw.githubusercontent.com/RedContritio/RedCognitio-Ads-Rule/main/scripts/xianyu-debug.js?v=0.1.0", {${xianyu_debug}}) with tag="闲鱼广告调试"

[MITM]
hostname = goofish.com, *.goofish.com, taobao.com, *.taobao.com
