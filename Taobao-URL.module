#!name=淘宝 广告拦截（开屏 · 跳脸彩蛋）
#!desc=以响应净化拦截开屏三条链路（图片 / 视频 / 活动）与 poplayer 弹层。需 MITM，Loon 3.5.1+
#!category=广告拦截
#!author=RedContritio
#!homepage=https://github.com/RedContritio/RedCognitio-Ads-Rule
#!version=0.1.0
#
# Copyright 2026 RedContritio
# SPDX-License-Identifier: Apache-2.0

[Rule]
# QUIC 无法 MITM，不拦则本文件全部规则与脚本静默失效
AND,((DOMAIN-SUFFIX,taobao.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,tmall.com),(PROTOCOL,QUIC)),REJECT

# 开屏不可用 REJECT：接口失败会触发客户端兜底素材（缓存/内置），广告照出。
# 故开屏走 [Script] 响应净化，此处只拦不触发兜底的两条链路。
# TopShow（阿里妈妈顶展，com.taobao/mmad/TopShowBootImage）
URL-REGEX,/mtop\.alimama\.topshow\.query,REJECT
URL-REGEX,/mtop\.alimama\.topshow\.interact,REJECT

# poplayer 配置下发（跳脸彩蛋）
URL-REGEX,/mtop\.taobao\.poplayer\.xdsl,REJECT

# 开屏全屏图兜底：HEIC 域，文件名含手机全屏尺寸
URL-REGEX,^https://heic\.alicdn\.com/imgextra/i[0-9]+/[0-9]*/?[A-Za-z0-9_!]+-[0-9]-(octopus|tps)-(1080|1125)-[0-9]{4}\.(jpg|png),REJECT

# 规则以逗号分隔字段，正则内不得出现逗号

[Script]
# 开屏图片与视频
response if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(wireless\.home\.splash\.awesome\.get|cloudvideo\.video\.query)/i then script("https://raw.githubusercontent.com/RedContritio/RedCognitio-Ads-Rule/main/scripts/Taobao-ads-clean.js") with tag="淘宝开屏净化", requires_body=true

# 开屏活动（poplayer 远程模板）
response if ${url} ~= /^https:\/\/poplayer\.template\.alibaba\.com\/\w+\.json/i then script("https://raw.githubusercontent.com/RedContritio/RedCognitio-Ads-Rule/main/scripts/Taobao-ads-clean.js") with tag="淘宝开屏活动净化", requires_body=true

# 不拦：首页主数据 / 推荐流 / newface 首页 / 商品详情 / 购物车 / 订单 / 搜索 /
#       mtop 网关 / 会场 H5 / gw.alicdn.com 商品图 / dinamicx 弹窗模板

[MITM]
hostname = taobao.com, *.taobao.com, *.tmall.com, heic.alicdn.com, poplayer.template.alibaba.com
