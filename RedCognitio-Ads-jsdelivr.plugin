#!name=RedCognitio 去广告合集（jsDelivr 镜像）
#!desc=知乎 / 淘宝 / 网易云音乐 / 哔咔 / 高德，按应用开关；Release · 1.0.8；jsDelivr 镜像；需 MITM，Loon 3.5.1+
#!author=RedContritio
#!homepage=https://github.com/RedContritio/RedCognitio-Ads-Rule
#!version=1.0.8
#!date=2026-10-29 · 1.0.8
#!loon_version=3.5.1(983)
#!category=广告拦截
#!type=normal
#
# Copyright 2026 RedContritio
# SPDX-License-Identifier: Apache-2.0

[Argument]
zhihu_enable = switch,true,type=boolean,tag=知乎-去广告,desc=过滤广告位与推广内容
zhihu_purify = switch,true,type=boolean,tag=知乎-净化,desc=隐藏首页视频、仅看当前问题、跳过会员受限回答并精简界面
taobao_enable = switch,true,type=boolean,tag=淘宝-去广告,desc=关闭后停止淘宝开屏与 poplayer 净化
netease_enable = switch,true,type=boolean,tag=网易云音乐-去广告,desc=关闭后停止网易云广告接口拦截
pica_enable = switch,true,type=boolean,tag=哔咔-去广告,desc=PicaWeb 注入去广告样式并自动翻过阅读器广告页；iOS 原生客户端由域名规则覆盖
amap_enable = switch,true,type=boolean,tag=高德地图-去广告,desc=改写开屏两条接口的响应并清空本地素材池；关闭后开屏恢复

# 说明：DOMAIN 级广告域规则不带开关，只封广告域，不会影响 App 正常功能。
# 需要完全关闭某个 App 时，直接把对应开关关掉即可；广告域本身不会造成业务影响。


[Rule]
# QUIC 无法 MITM，不拦则本文件全部规则静默失效
AND,((DOMAIN-SUFFIX,zhihu.com),(PROTOCOL,QUIC)),REJECT

# 开屏在自有接口失败时回落三方联盟。同样用 REJECT-DICT：DROP 会让 SDK 等待超时，疑似开屏不稳定的成因
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,gdt.qq.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,tanx.com,REJECT-DICT,extended-matching,pre-matching

# 知乎自有广告域（AWAvenue 与 anti-AD 均未收录）
DOMAIN,adaudit.zhihu.com,REJECT,extended-matching,pre-matching
DOMAIN,promotion.zhihu.com,REJECT,extended-matching,pre-matching

# 友盟 deeplink 归因 + 设备指纹（两套通用规则集均未收录）
DOMAIN,deeplink.umeng.com,REJECT,extended-matching,pre-matching

DOMAIN,ad.reward.net,REJECT,extended-matching,pre-matching

DOMAIN-SUFFIX,kwaizt.com,REJECT,extended-matching,pre-matching

# 以下由 anti-AD 等通用规则集覆盖，故不重复；停用它们时取消注释
# DOMAIN,dsp.ads.umeng.com,REJECT
# DOMAIN-SUFFIX,volceapplog.com,REJECT
# DOMAIN-SUFFIX,oceanengine.com,REJECT
# DOMAIN,log.snssdk.com,REJECT
# DOMAIN,applog.snssdk.com,REJECT
# DOMAIN,rtlog.snssdk.com,REJECT
# DOMAIN,rtapplog.snssdk.com,REJECT
# DOMAIN,ichannel.snssdk.com,REJECT

# QUIC 无法 MITM，不拦则本文件全部规则与脚本静默失效
AND,((DOMAIN-SUFFIX,taobao.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,tmall.com),(PROTOCOL,QUIC)),REJECT

# 淘宝：TopShow、poplayer、HEIC 开屏兜底已改为 [Rewrite] 中按 taobao_enable 生效。


# QUIC 无法 MITM，不拦则本文件全部规则静默失效
AND,((DOMAIN-SUFFIX,music.163.com),(PROTOCOL,QUIC)),REJECT

# 网易云音乐：广告接口已改为 [Rewrite] 中按 netease_enable 生效。
# 下面只保留广告素材 CDN / 监测域的域名级拦截。

# 素材 CDN 与曝光监测
DOMAIN,iadmusicmat.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmusicmatvideo.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,admusicpic.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmat.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmatapk.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN,iad.service.163.org,REJECT,extended-matching,pre-matching

# NCM 广告种子 SDK（包内 sd-gl.xinqiucc.com/psdk/getseeds_v2）
DOMAIN-SUFFIX,xinqiucc.com,REJECT,extended-matching,pre-matching

# eapi 直连 IP 已改为 [Rewrite] 中按 netease_enable 生效。


# 三方广告监测厂商（AWAvenue 等未覆盖）
DOMAIN,admaster.com.cn,REJECT,extended-matching,pre-matching
DOMAIN,attri.mobi,REJECT,extended-matching,pre-matching
DOMAIN,mmstat.com,REJECT,extended-matching,pre-matching
DOMAIN,rtbasia.com,REJECT,extended-matching,pre-matching
DOMAIN,hegek7.com,REJECT,extended-matching,pre-matching
DOMAIN,adbug.cn,REJECT,extended-matching,pre-matching
DOMAIN,gridsum.com,REJECT,extended-matching,pre-matching

# 以下两条通用规则集只封了子域，未封主域；SDK 会轮换子域，故封主域
DOMAIN,miaozhen.com,REJECT,extended-matching,pre-matching
DOMAIN,doubleclick.net,REJECT,extended-matching,pre-matching

# 已由 AWAvenue 精确覆盖，停用该规则集时取消注释
# DOMAIN,iadmusicmat.music.126.net,REJECT
# DOMAIN,iad.g.163.com,REJECT
# DOMAIN,ad.bn.netease.com,REJECT

# QUIC 无法 MITM；Cloudflare 对 h3 有 Alt-Svc，浏览器用上 h3 后哔咔注入静默失效
AND,((DOMAIN-SUFFIX,manhuabika.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,picacomic.com),(PROTOCOL,QUIC)),REJECT

# 哔咔自建广告服务器：/get-ad-zones 下发、/redirect 跳转、/medias 素材、/android/* H5 广告页
# iOS 原生客户端（Flutter AdRemoteDataSource）与 PicaWeb 共用这个域；API 域会轮换，广告域不换
DOMAIN-SUFFIX,diwodiwo.xyz,REJECT,extended-matching,pre-matching

# 旧版 Android 客户端的 H5 广告位宿主，2026-10-29 实测已不响应，保留防回切
DOMAIN,pica-juicy.picacomic.com,REJECT,extended-matching,pre-matching

# 兜底：iOS 端把广告域写成前缀形式 https://pica-ad-api.<domain>
DOMAIN-KEYWORD,pica-ad-api,REJECT,extended-matching,pre-matching

# ══ 高德地图（com.autonavi.minimap，17.02.0.2010 取证）══
# 开屏两条链路已改为 [Rewrite] 中按 amap_enable 生效。
# QUIC 无法 MITM，不拦则上面两条 [Rewrite] 静默失效。只降级开屏用到的两个主机：
# m5.amap.com 同时承载地图瓦片 / 检索 / 导航 / 账号，不能全域降级。
AND,((DOMAIN,m5.amap.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,amap-aos-info-nogw.amap.com),(PROTOCOL,QUIC)),REJECT

# 高德包内没有穿山甲 / 优量汇 / 快手联盟 / Sigmob / Mintegral 等三方联盟 SDK，
# 开屏只有阿里妈妈自建一条来源，所以本文件不维护高德侧的联盟域名清单。
# 素材 CDN（gw.alicdn.com / aoscdn.amap.com / aos-cdn-image.amap.com）与地图皮肤、
# POI 图共用，不拦；开屏素材 URL 还是接口动态下发的，域名级封不到。

[Rewrite]
# 淘宝：TopShow 顶展、poplayer 配置、HEIC 开屏兜底（原先的 URL-REGEX 规则，改为按开关生效）
request if ${taobao_enable} == true && ${url} ~= /\/mtop\.alimama\.topshow\.query/ then reject(404)
request if ${taobao_enable} == true && ${url} ~= /\/mtop\.alimama\.topshow\.interact/ then reject(404)
request if ${taobao_enable} == true && ${url} ~= /\/mtop\.taobao\.poplayer\.xdsl/ then reject(404)
request if ${taobao_enable} == true && ${url} ~= /^https:\/\/heic\.alicdn\.com\/imgextra\/i[0-9]+\/[0-9]*\/?[A-Za-z0-9_!]+-[0-9]-(octopus|tps)-(1080|1125)-[0-9]{4}\.(jpg|png)/ then reject(404)

# 网易云音乐：广告接口（按开关生效）
request if ${netease_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*music\.163\.com\/[a-z]*api\/ad\/(loading|prefetch|get|flow|materialconfig|commonconfig|config|monitor|sniffing|start|device)/ then reject(404)
request if ${netease_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*music\.163\.com\/[a-z]*api\/(social\/event\/bff\/ad\/|ichat\/home\/ad\/list)/ then reject(404)
request if ${netease_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*music\.163\.com\/[a-z]*api\/delivery\/(batch-)?deliver/ then reject(404)
# eapi 直连 IP：关闭开关后不拦，避免影响正常播放
request if ${netease_enable} == true && ${url} ~= /^https?:\/\/ipv[46]\.music\.163\.com\// then reject(404)

# ══ 传输层：改写云配置禁用 HTTPDNS 与 QUIC ══
response if (${zhihu_enable} == true || ${zhihu_purify} == true) && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/api\/cloud\/zhihu\/config\/all/i then response.json.jq("def disabled_keys: {\"km_httpdns_new_config_tars\":true,\"preFetchHttpDns\":true,\"httpdns_detector_use_concurrent\":true,\"httpdns_use_memory_cache\":true,\"httpdns_new_config_tars\":true,\"tarsMixAb\":true,\"sugarQuicConfig\":true,\"quic_dns_detect_enable\":true,\"quicMixAB\":true,\"quic_downgrade_enable\":true,\"quic_priority_strategy\":true,\"quic_check_health_enable\":true,\"tquic_configuration\":true,\"networkExprimentList\":true,\"tars_ab_list\":true,\"zaSetExtraRequestHeader\":true}; def disable_dns: if type == \"object\" then if has(\"whiteHosts\") then .whiteHosts = [] else . end | if has(\"isDetectorClosed\") then .isDetectorClosed = 1 else . end | if has(\"isBackupIPClosed\") then .isBackupIPClosed = 1 else . end | if has(\"isDowngradeClosed\") then .isDowngradeClosed = 0 else . end | if has(\"dnsParser\") and (.dnsParser | type) == \"object\" then .dnsParser.httpdnsEnable = 0 else . end else . end; def disable_core_dns: if type == \"object\" then .ZHHttpDnsStartupItem_PreResolveHostsSample = \"0\" | .ZHSwitchHTTPDNSFunction_switchHTTPDNS = \"0\" | .ZHSwitchHTTPDNSFunction_switchHTTPDNSNew = {ratio: 0, whiteHosts: []} | .ZHBackUpIP_Switch_Open = \"0\" | .ZHBackUpIP_Detecter_Open = \"0\" | .ZHBackUpIPDetector_Open_backupipDetector = \"0\" | .LocalDNSSetHostWhiteList = [] else . end; if (.data.configs | type) == \"array\" then .data.configs |= map( if type != \"object\" then . elif .configKey == \"coreNetworkConf_useTars\" or .configKey == \"km_coreNetworkConf_useTars\" then .configValue |= disable_core_dns | .configVersion = \"20261024.03.30.00001\" elif (disabled_keys[.configKey // \"\"] // false) == true then .status = false | .configValue |= disable_dns | .configVersion = \"20261024.03.30.00001\" else . end) else . end")

# ══ 广告位 ══
# 14 个广告位接口，含开屏 launch_v2、按回答 ID 请求的 bottom-v2
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/commercial_api\//i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/ad-style-service\//i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/ad-track\//i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/adx\/third_sdk_info/i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/adEngine\//i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/fringe\/ad/i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/content-distribution-core\/bubble\/common\/show/i then reject_dict(200)

# ══ 回答流 ══
request if ${zhihu_purify} == true && ${url} ~= /^(https?:\/\/(?:[a-z0-9-]+\.)*zhihu\.com\/(?:simple-)?next-render\?)(?=(?:[^&#]*&)*type=answer(?:&|$))((?:[^&#]*&)*scenes=)[^&#]*/i as answerFlow then url.replace("${answerFlow.1}${answerFlow.2}question")

# ══ 内容净化 ══
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/comment_v[0-9]+\/(answers|pins)\/[0-9]+\/root_comment/i then response.json.delete("atmosphere_voting_config")
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/comment_v[0-9]+\/(answers|articles|pins)\/[0-9]+\/list-headers/i then response.json.delete("continuous_consumption_module")
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/people\/self/i then response.json.jq("reduce [\"vip_info\", \"kvip_info\"][] as $key (.; if (.[$key] | type) == \"object\" then .[$key] |= with_entries(select(.key | startswith(\"entrance\") | not)) else . end)")

# 回答底部广告：/commercial_api/answer/{id}/bottom-v2 返回 {"adjson":"..."}
response if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api\/answer\/[0-9]+\/bottom-v2/i then response.json.delete("adjson")

# 回答底部品牌广告：PAG 素材走 zhstatic.zhihu.com/brand-ad/
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/zhstatic\.zhihu\.com\/brand-ad\//i then reject(404)

# ══ 界面精简 ══
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/root\/tab(?:\/v[0-9]+)?/i then response.json.jq(".tab_list |= map(select(.tab_type == \"follow\" or .tab_type == \"recommend\" or .tab_type == \"hot\" or .tab_type == \"ring_tab\"))")
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/search\/tabs/i then response.json.jq(".data |= map(select(.t | IN(\"general\", \"ai_zhida\", \"recent\", \"people\", \"ring\", \"topic\", \"podcast\", \"column\", \"pin\", \"favlist\")))")

# ══ 推广位 ══
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/related_recommend\/feed\/waterfall/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/search\/preset_words/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/search\/related_queries\/question\/[0-9]+/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/api\/v[0-9]+\/members\/homepage_card/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/people\/homepage_entry_v[0-9]+/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/kvip\/right\/my_card/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/unlimited\/go\/my_card\/(?:v[0-9]+|all)(?:[/?]|$)/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhida\.zhihu\.com\/ai_ingress\/knowledge\/square\/categories\/feeds/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhida\.zhihu\.com\/ai_ingress\/ai_chat\/guidance/i then reject_dict(200)

response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/search\/recommend_query\/v[0-9]+/i then response.json.jq(".recommend_queries.queries |= map(select(.type == \"normal\"))")
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/podcasts\/hub\/v[0-9]+/i then response.json.delete("banners")

# sugar.zhihu.com 兼作网络探活域（/check_health），故按路径拦而非整域

# [实验] 回答底部广告：page-info 可能是广告卡的注入源。
# 开启后若回答页空白/无法加载，立即注释回去；能正常看回答但底部广告消失就保留。
# request if ${zhihu_enable} == true && ${url} ~= /^https:\/\/page-info\.zhihu\.com\/(answers|articles)\/v2\//i then reject_dict(200)

# 哔咔：PicaWeb 的 Service Worker 会把导航喂成预缓存壳，注入进不去，先拒掉注册地址
request if ${pica_enable} == true && ${url} ~= /^https:\/\/(?:www\.)?manhuabika\.com\/(?:sw\.js|workbox-[^\/?#]+\.js)/ then reject(404)

# ══ 高德地图：开屏两条链路 ══
# 链路 1：阿里妈妈素材下发（池化）。com.autonavi.minimap.alimama.param.SplashScreenRequest#E
#   = ConfigerHelper.AOS_URL_KEY("aos_url" → https://m5.amap.com/) + "ws/valueadded/alimama/splash_screen"
#   冷启动 / 热切（scene 100/101/104/105/106/108/110、102/103）与 Wi-Fi 预取都走这条。
#   响应 {"code":"1"|"7","data":{"ad":[…]}}，data.ad 才是素材条目。
# 链路 2：实时「秒开」。URL 由云控 splashscreen.realtime_scene_config 下发，写到
#   https://amap-aos-info-nogw.amap.com/ws/aos/alimama/splash_screen_rt?ent=2
#   响应同样是 code + data，但素材在 data.custom_list[].creative[]，不是 ad（a.f 只读 custom_list）。
#
# 为什么用字段净化而不是 reject_dict：
#   com.autonavi.minimap.net.Callback#onSuccess 先看 code，只有 "1"/"7" 才往下走；
#   走成功分支的第一件事就是 remove("afp_splash_events") + dc2.m(null)——把本地开屏广告池
#   和实时条目一起清掉，再把 data.ad 解析成列表。返回空 ad 等于「服务端说今天没广告」，
#   池子被清空且不下载素材。reject_dict 走的是失败分支（invalid_resp），池子原样保留，
#   已下发的广告还会照播到 end_time，得手动清 App 缓存。字段净化把这一步省了。
#   code 用 "7"（客户端对 7 与 1 同等对待）；data 留空对象，实时链路找不到 custom_list
#   自然判定无素材，两条链路一个响应体够用。
response if ${amap_enable} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)*amap\.com\/ws\/valueadded\/alimama\/splash_screen/ then response.json.jq("{\"code\":\"7\",\"data\":{}}")
response if ${amap_enable} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)*amap\.com\/ws\/aos\/alimama\/splash_screen_rt/ then response.json.jq("{\"code\":\"7\",\"data\":{}}")

# 备选（不推荐）：reject_dict(200) 也能让开屏不出现，但不清本地池，旧素材会播到 end_time。
# request if ${amap_enable} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)*amap\.com\/ws\/valueadded\/alimama\/splash_screen/ then reject_dict(200)

# 不拦：ws/shield/dsp/app/startup/init（云控开关，含开屏频控与试验配置，拦了整个启动配置回退默认）、
#       ws/shield/frogserver/aocs/updatable/1（AOCS 云控，splashscreen 模块就在这里下发，
#       但响应结构带模块级 version/status，改写成本高且回退默认值反而更爱放广告）、
#       ws/banner/lists（首页 banner，不是开屏）、ws/device/adius/（设备 ID 上报）。

[Script]

# 开屏图片与视频
response if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(wireless\.home\.splash\.awesome\.get|cloudvideo\.video\.query)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/release/scripts/Taobao-ads-clean.js?v=1.0.8") with enable=${taobao_enable}, tag="淘宝开屏净化", requires_body=true

# 开屏活动（poplayer 远程模板）
response if ${url} ~= /^https:\/\/poplayer\.template\.alibaba\.com\/\w+\.json/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/release/scripts/Taobao-ads-clean.js?v=1.0.8") with enable=${taobao_enable}, tag="淘宝开屏活动净化", requires_body=true

# 不拦：首页主数据 / 推荐流 / newface 首页 / 商品详情 / 购物车 / 订单 / 搜索 /
#       mtop 网关 / 会场 H5 / gw.alicdn.com 商品图 / dinamicx 弹窗模板


# 哔咔：PicaWeb 页面注入（路径无扩展名才可能是 SPA 的 HTML，assets 与接口不进脚本）
response if ${pica_enable} == true && ${url} ~= /^https?:\/\/(?:www\.)?(?:manhuabika\.com|picacomic\.com)\/+(?![^?#]*\.[a-z0-9]+(?:[?#]|$))/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/release/scripts/pica-clean.js?v=1.0.8", {${pica_enable}}) with tag="哔咔去广告注入", requires_body=true

response if (${zhihu_enable} == true || ${zhihu_purify} == true) && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/(?:api\/)?(?:search_v[0-9]+|topstory\/recommend|(?:simple-)?next-render|(?:v[0-9]+\/)?questions|(?:v[0-9]+\/)?(?:answers|articles|pins)(?:\/v[0-9]+)?\/[0-9]+)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/release/scripts/zhihu-clean.js?v=1.0.8", {${zhihu_enable}, ${zhihu_purify}}) with tag="知乎内容净化", requires_body=true

# 高德：开屏接口诊断。iOS 取不到可解密样本，开屏到底走哪台 AOS 主机只能靠抓一次启动回答；
# 日志里 AMDEBUG 行的主机名决定 [MITM] 要不要补，AMDUMP-* 是响应体。

[MITM]
hostname = zhihu.com, *.zhihu.com, taobao.com, *.taobao.com, *.tmall.com, heic.alicdn.com, poplayer.template.alibaba.com, music.163.com, *.music.163.com, ipv4.music.163.com, ipv6.music.163.com, manhuabika.com, *.manhuabika.com, picacomic.com, www.picacomic.com, m5.amap.com, amap-aos-info-nogw.amap.com
