#!name=闲鱼 广告域名拦截
#!desc=穿山甲 / 优量汇 / TanX 的素材与竞价域，无需 MITM
#!category=广告拦截
#!author=RedContritio
#!homepage=https://github.com/RedContritio/RedCognitio-Ads-Rule
#!version=0.1.0
#!date=2026-10-26 · 0.1.0
#!loon_version=3.5.1(983)
#
# Copyright 2026 RedContritio
# SPDX-License-Identifier: Apache-2.0

[Rule]
# QUIC 无法 MITM，不拦则 URL 规则与响应净化全部静默失效
AND,((DOMAIN-SUFFIX,goofish.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,taobao.com),(PROTOCOL,QUIC)),REJECT

# ══ 穿山甲（com.bytedance.sdk.openadsdk + GroMore 聚合，权限 TT_PANGOLIN 在清单内）══
# 用 REJECT-DICT 而非 REJECT：SDK 拿到结构完整的空响应会走 onNoAd，不会等超时。
# sf3-fe-tos.pglstatp-toutiao.com 是素材与模板静态资源，包内 61 处引用。
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT-DICT,extended-matching,pre-matching

# ══ 优量汇（com.qq.e，开屏 adapter key = ylh）══
DOMAIN-SUFFIX,gdt.qq.com,REJECT-DICT,extended-matching,pre-matching

# ══ TanX / 阿里妈妈交易侧（click.tanx.com、ef-dongfeng.tanx.com 在包内）══
DOMAIN-SUFFIX,tanx.com,REJECT-DICT,extended-matching,pre-matching

# ══ 待抓包确认 ══
# 快手（com.kwad）、倍孜（com.beizi.ad）、Sigmob：包内只有 Java 组件与 GroMore adapter，
# 未内嵌明文域名，实际投放域需真机抓包后补入。常见候选：open.kuaishouzt.com、kwaizt.com。
# DOMAIN-SUFFIX,kwaizt.com,REJECT-DICT,extended-matching,pre-matching

# ══ 明确不拦 ══
# api.goofish.com、acs.m.taobao.com、guide-acs.m.taobao.com、trade-acs.m.taobao.com：mtop 业务网关
# gw.alicdn.com、img.alicdn.com、heic.alicdn.com、cdn-img.ingoofish.com：商品图与素材
# adash / adashx（adash.m.taobao.com、h-adashx.ut.taobao.com 等）：阿里系埋点，拦掉不影响展示，
#   但会让广告归因与「不感兴趣」反馈失效，故保留。
# 规则以逗号分隔字段，正则内不得出现逗号；量词 {n,m} 会截断规则，故用 * 或 +
