#!name=RedCognitio 去广告合集（Debug · jsDelivr 镜像）
#!desc=知乎 / 淘宝 / 网易云音乐 / 哔咔 / 高德 / missav / JAV 站族 / 多邻国，按应用开关；Debug · 1.0.18；jsDelivr 镜像；需 MITM，Loon 3.5.1+
#!author=RedContritio
#!homepage=https://github.com/RedContritio/RedCognitio-Ads-Rule
#!version=1.0.18
#!date=2026-10-31 · 1.0.18
#!loon_version=3.5.1(983)
#!category=广告拦截
#!type=normal
#
# Copyright 2026 RedContritio
# SPDX-License-Identifier: Apache-2.0

[Argument]
zhihu_enable = switch,true,type=boolean,tag=知乎-去广告,desc=过滤广告位与推广内容
zhihu_purify = switch,true,type=boolean,tag=知乎-净化,desc=隐藏首页视频、仅看当前问题、跳过会员受限回答并精简界面
taobao_enable = switch,true,type=boolean,tag=淘宝-去广告,desc=关闭后停止淘宝开屏与 poplayer 净化
netease_enable = switch,true,type=boolean,tag=网易云音乐-去广告,desc=关闭后停止网易云广告接口拦截
pica_enable = switch,true,type=boolean,tag=哔咔-去广告,desc=PicaWeb 注入去广告样式并自动翻过阅读器广告页；iOS 原生客户端由域名规则覆盖
amap_enable = switch,true,type=boolean,tag=高德地图-去广告,desc=改写开屏两条接口的响应并清空本地素材池；关闭后开屏恢复
xianyu_enable = switch,true,type=boolean,tag=闲鱼-去广告,desc=清空开屏广告池并剔除信息流、搜索里的广告卡；关闭后恢复
zhihu_debug = switch,false,type=boolean,tag=知乎-调试,desc=记录过滤计数、解析错误与完整搜索响应
taobao_debug = switch,false,type=boolean,tag=淘宝-调试,desc=记录响应净化结果与解析错误
netease_debug = switch,false,type=boolean,tag=网易云音乐-调试,desc=记录进入脚本的 API 请求方法与 URL
pica_debug = switch,false,type=boolean,tag=哔咔-调试,desc=记录注入命中与跳过注入的原因
amap_debug = switch,false,type=boolean,tag=高德地图-调试,desc=记录开屏接口的真实主机名与完整响应
xianyu_debug = switch,false,type=boolean,tag=闲鱼-调试,desc=记录广告接口请求、完整响应与信息流卡片结构
missav_enable = switch,true,type=boolean,tag=missav-去广告,desc=拆掉 smartpop/popunder 弹窗、页面广告位与联盟推广位；关闭后恢复
missav_debug = switch,false,type=boolean,tag=missav-调试,desc=记录 htmlAds/iframe/联盟位/pop() 各项命中数
jav_enable = switch,true,type=boolean,tag=JAV 站族-去广告,desc=删掉 18AV / 123AV / JavBus 这类站的第三方广告 iframe、广告 SDK 与广告位占位
jav_debug = switch,false,type=boolean,tag=JAV 站族-调试,desc=记录各站 iframe / 脚本 / 广告位的命中数与体积变化
duolingo_enable = switch,false,type=boolean,tag=多邻国-去广告,desc=改写用户数据的订阅档位，插屏（含 Super 推广）不再下发；涉及账号状态，默认关闭，先用小号验证
duolingo_debug = switch,false,type=boolean,tag=多邻国-调试,desc=记录命中的响应形态与改写结果；另输出 DUODUMP 键名清单，用于判据失效时定位

# 说明：DOMAIN 级广告域规则不带开关，只封广告域，不会影响 App 正常功能。
# 需要完全关闭某个 App 时，直接把对应开关关掉即可；广告域本身不会造成业务影响。


[Rule]
# QUIC 无法 MITM，不拦则本文件全部规则静默失效
AND,((DOMAIN-SUFFIX,zhihu.com),(PROTOCOL,QUIC)),REJECT

# 开屏在自有接口失败时回落三方联盟。同样用 REJECT-DICT：DROP 会让 SDK 等待超时，疑似开屏不稳定的成因
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,gdt.qq.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,tanx.com,REJECT-DICT,extended-matching,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT-DICT,extended-matching,pre-matching

# 知乎自有广告域（AWAvenue 与 anti-AD 均未收录）
DOMAIN,adaudit.zhihu.com,REJECT,extended-matching,pre-matching
DOMAIN,promotion.zhihu.com,REJECT,extended-matching,pre-matching

# 友盟 deeplink 归因 + 设备指纹（两套通用规则集均未收录）
DOMAIN,deeplink.umeng.com,REJECT,extended-matching,pre-matching

DOMAIN,ad.reward.net,REJECT,extended-matching,pre-matching

DOMAIN-SUFFIX,kwaizt.com,REJECT,extended-matching,pre-matching

# 以下由 anti-AD 等通用规则集覆盖，故不重复；停用它们时取消注释
# DOMAIN,dsp.ads.umeng.com,REJECT
# DOMAIN-SUFFIX,volceapplog.com,REJECT
# DOMAIN-SUFFIX,oceanengine.com,REJECT
# DOMAIN,log.snssdk.com,REJECT
# DOMAIN,applog.snssdk.com,REJECT
# DOMAIN,rtlog.snssdk.com,REJECT
# DOMAIN,rtapplog.snssdk.com,REJECT
# DOMAIN,ichannel.snssdk.com,REJECT

# QUIC 无法 MITM，不拦则本文件全部规则与脚本静默失效
AND,((DOMAIN-SUFFIX,taobao.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,tmall.com),(PROTOCOL,QUIC)),REJECT

# 淘宝：TopShow、poplayer、HEIC 开屏兜底已改为 [Rewrite] 中按 taobao_enable 生效。


# QUIC 无法 MITM，不拦则本文件全部规则静默失效
AND,((DOMAIN-SUFFIX,music.163.com),(PROTOCOL,QUIC)),REJECT

# 网易云音乐：广告接口已改为 [Rewrite] 中按 netease_enable 生效。
# 下面只保留广告素材 CDN / 监测域的域名级拦截。

# 素材 CDN 与曝光监测
DOMAIN,iadmusicmat.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmusicmatvideo.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,admusicpic.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmat.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmatapk.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN,iad.service.163.org,REJECT,extended-matching,pre-matching

# NCM 广告种子 SDK（包内 sd-gl.xinqiucc.com/psdk/getseeds_v2）
DOMAIN-SUFFIX,xinqiucc.com,REJECT,extended-matching,pre-matching

# eapi 直连 IP 已改为 [Rewrite] 中按 netease_enable 生效。


# 三方广告监测厂商（AWAvenue 等未覆盖）
DOMAIN,admaster.com.cn,REJECT,extended-matching,pre-matching
DOMAIN,attri.mobi,REJECT,extended-matching,pre-matching
DOMAIN,mmstat.com,REJECT,extended-matching,pre-matching
DOMAIN,rtbasia.com,REJECT,extended-matching,pre-matching
DOMAIN,hegek7.com,REJECT,extended-matching,pre-matching
DOMAIN,adbug.cn,REJECT,extended-matching,pre-matching
DOMAIN,gridsum.com,REJECT,extended-matching,pre-matching

# 以下两条通用规则集只封了子域，未封主域；SDK 会轮换子域，故封主域
DOMAIN,miaozhen.com,REJECT,extended-matching,pre-matching
DOMAIN,doubleclick.net,REJECT,extended-matching,pre-matching

# 已由 AWAvenue 精确覆盖，停用该规则集时取消注释
# DOMAIN,iadmusicmat.music.126.net,REJECT
# DOMAIN,iad.g.163.com,REJECT
# DOMAIN,ad.bn.netease.com,REJECT

# QUIC 无法 MITM；Cloudflare 对 h3 有 Alt-Svc，浏览器用上 h3 后哔咔注入静默失效
AND,((DOMAIN-SUFFIX,manhuabika.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,picacomic.com),(PROTOCOL,QUIC)),REJECT

# 哔咔自建广告服务器：/get-ad-zones 下发、/redirect 跳转、/medias 素材、/android/* H5 广告页
# iOS 原生客户端（Flutter AdRemoteDataSource）与 PicaWeb 共用这个域；API 域会轮换，广告域不换
DOMAIN-SUFFIX,diwodiwo.xyz,REJECT,extended-matching,pre-matching

# 旧版 Android 客户端的 H5 广告位宿主，2026-10-29 实测已不响应，保留防回切
DOMAIN,pica-juicy.picacomic.com,REJECT,extended-matching,pre-matching

# 兜底：iOS 端把广告域写成前缀形式 https://pica-ad-api.<domain>
DOMAIN-KEYWORD,pica-ad-api,REJECT,extended-matching,pre-matching

# ══ 高德地图（com.autonavi.minimap，17.02.0.2010 取证）══
# 开屏两条链路已改为 [Rewrite] 中按 amap_enable 生效。
# QUIC 无法 MITM，不拦则上面两条 [Rewrite] 静默失效。只降级开屏用到的三个主机：
# m5.amap.com / m5-x.amap.com 同时承载地图瓦片 / 检索 / 导航 / 账号，不能全域降级。
# m5-x.amap.com = ConfigerHelper 里 aosx_url → aos.xurl 的首选主机（e02.c()：
#   https://m5-x.amap.com/ ｜ http://amaps.testing.amap.com/ ｜ https://pre-gateway-x.amap.com/）。
# iOS 17.01.1 实测：冷启动与每次热切的批量 AOS 请求都落在这台机上（单次启动 20-48 条连接），
# 它不在 [MITM] 里就解密不了，链路 1 的池化下发整条漏掉——见 Amap.md §9。
AND,((DOMAIN,m5.amap.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,m5-x.amap.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,amap-aos-info-nogw.amap.com),(PROTOCOL,QUIC)),REJECT

# ══ 闲鱼（com.taobao.idlefish，7.27.96.8 取证；业务域 goofish.com）══
# 自建开屏 + 三方 SDK 混合。开屏、信息流、搜索全部走 mtop，落在 goofish.com 与 taobao.com 两套网关上，
# 两套都要拦 QUIC，否则下面的响应净化静默失效。域名层（穿山甲 / 优量汇 / TanX / 快手）见上方联盟段。
AND,((DOMAIN-SUFFIX,goofish.com),(PROTOCOL,QUIC)),REJECT

# 高德包内没有穿山甲 / 优量汇 / 快手联盟 / Sigmob / Mintegral 等三方联盟 SDK，
# 开屏只有阿里妈妈自建一条来源，所以本文件不维护高德侧的联盟域名清单。
# 素材 CDN（gw.alicdn.com / aoscdn.amap.com / aos-cdn-image.amap.com）与地图皮肤、
# POI 图共用，不拦；开屏素材 URL 还是接口动态下发的，域名级封不到。

# ══ missav（missav.ws / missav123.com / missav.ai / missav.live，2026-10-30 取证）══
# 站点是 Cloudflare + Laravel 服务端渲染，广告没有「广告位接口」：
#   1. 服务端直出 smartpop iframe（go.mayzaent.com/smartpop/<64 hex>），302 → creative.greentrafsa.com
#      的 lib-auto.js，自己继续 window.open，首页 12 秒实测 6 个新标签；
#   2. 页面尾部内联 htmlAds 脚本，每次随机挑 1 条（Stripchat Spot 悬浮 / 右下 300×100 / smartpop）；
#   3. 播放器容器 @click="pop()"，window.open('/pop?url=…') 新开标签，广告池 17 条、24 小时轮换。
# 所以域名层只做兜底：白标广告网络的注册域固定、子域（creative. / t. / go.）轮换，按注册域封。
DOMAIN-SUFFIX,myavlive.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,mavrtracktor.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,greentrafsa.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,mayzaent.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,rallytrck.website,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,snaptrckr.fun,REJECT,extended-matching,pre-matching
# pop() 广告池里的 TrafficStars 直链与 adraw 广告位
DOMAIN-SUFFIX,tsyndicate.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,twinrdengine.com,REJECT,extended-matching,pre-matching
# pop() 广告池里的跳转型落地（diffusedpassionquaking.com/1919723/）
DOMAIN-SUFFIX,diffusedpassionquaking.com,REJECT,extended-matching,pre-matching

# QUIC 无法 MITM；站点响应头带 alt-svc h3，Safari 用上 h3 后注入与本文件的 /pop 拦截都会静默失效
AND,((DOMAIN-SUFFIX,missav123.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,missav.ws),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,missav.ai),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,missav.live),(PROTOCOL,QUIC)),REJECT

# 不拦：fourhoi.com 封面图 CDN、cdnjs.cloudflare.com（plyr / hls.js）、client-rapi-missav.recombee.com
# 推荐接口。bit.ly 是联盟推广位用的短链，整域封会影响其它场景，改在注入层从 HTML 里删 <a>。
# GTM（GTM-P32NTRH6）只做统计，默认保留；要断统计时取消下面一行：
# DOMAIN,www.googletagmanager.com,REJECT,extended-matching,pre-matching

# ══ JAV 站族：按广告网络覆盖，不按站点（2026-10-30 取证）══
# 这批站没有共享模板，共享的是广告网络。判据取广告网络自己的特征：
#   ExoClick   18av 服务端直出 <iframe src='//a.magsrv.com/iframe.php?idzone=…'>；
#              123av/njav 走 <script src="a.magsrv.com/ad-provider.js"> + <ins data-zoneid> + 内联 popMagic
#   JuicyAds   javbus 的 poweredby.jads.co / i.jads.co
# 所以域名层封网络、注入层删容器，一个站只需在名单里加一个域名。
DOMAIN-SUFFIX,exoclick.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,exosrv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,magsrv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pemsrv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,realsrv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,jads.co,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,jads.cc,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,juicyads.com,REJECT,extended-matching,pre-matching
# JavBus / 部分站的 TrafficStars 与 TrafficJunky 位
DOMAIN-SUFFIX,trafficjunky.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,trafficjunky.net,REJECT,extended-matching,pre-matching

# QUIC 无法 MITM；这些站多在 Cloudflare 后且带 alt-svc h3
AND,((DOMAIN-SUFFIX,18av.mm-cg.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,njav.tv),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,123av.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,javdb.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,javbus.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,jav321.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,javgg.net),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,supjav.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,javlibrary.com),(PROTOCOL,QUIC)),REJECT

# 不拦：各站自家素材域（c0.jdbstatic.com、javcode.net、bkcdn.net、eemmhh01.com 等），
# 以及 javdb 的 Yandex Metrica。JAVGG / JavDB / JAV321 首页实测没有第三方广告，
# 名单里保留它们只是为了注入层不误判，规则本身对它们无副作用。

[Rewrite]
# ══ missav：popunder 中转页 ══
# 播放器上的 pop() 会 window.open('/pop?url=<广告落地>')，这个中转页只服务弹窗。
# 与下面注入层里摘 @click="pop()" 必须同批上线：只封 /pop 会出现「点一下开空白标签，
# 回来还要再点一次播放」，因为 pop() 的定时器只在弹窗被关掉后才替你 player.play()。
request if ${missav_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*(?:missav123\.com|missav\.(?:ws|ai|live))\/pop\?url=/i then reject(404)

# ══ 闲鱼：开屏池 / 信息流广告卡 / 搜索广告 ══
# 开屏只能清响应不能拦请求：SplashAdController 失败后会 requestAsyncSplashAd 再取一次，
# 并把素材写进 SplashAdCacheManager；异步再失败时客户端仍读旧缓存。所以让响应成功但池为空。
# data 必须保留为对象——onSuccess 里有 getData().requestId 的取值路径，null 会走异常分支。
#   mtop.taobao.idlecommerce.splash.ads（2.0，同步）/ splash.async.ads（1.0，预取）
response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlecommerce\.splash(?:\.async)?\.ads\//i then response.json.jq("if (.data | type) == \"object\" then .data |= (.adMap = {} | .cacheAdInfo = null | .realTimeAd = null) else . end")

# 信息流卡片类型在 data.clickParam.args.cardType；只删广告卡，普通卡原样保留
# （不用模板名白名单：接口换模板会把整屏清空）。同城首页用的是 template.cardEnum。
response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\//i then response.json.jq("if (.data.sections | type) == \"array\" then .data.sections |= map(select((try (.data.clickParam.args.cardType) catch null) as $ct | $ct != \"mamaAD\" and $ct != \"homeMultiBanner\")) else . end")
response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlehome\.home\.newitem\.page\//i then response.json.jq("if (.data.sections | type) == \"array\" then .data.sections |= map(select((try (.data.clickParam.args.cardType) catch null) as $ct | $ct != \"mamaAD\" and $ct != \"banner\")) else . end")
response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idle\.local\.home\//i then response.json.jq("if (.data.sections | type) == \"array\" then .data.sections |= map(select((try (.template.cardEnum) catch null) != \"ads\")) else . end")

# 搜索结果广告带 dislikeFeedback.clickParam.args.bizType == "ad"，同结构的普通结果保留
response if ${xianyu_enable} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlemtopsearch\.search\//i then response.json.jq("if (.data.resultList | type) == \"array\" then .data.resultList |= map(select((try (.data.item.main.exContent.dislikeFeedback.clickParam.args.bizType) catch null) != \"ad\")) else . end")

# 明确不拦：idle.item.recommend.list / buy.feeds / playboy.recommend / user.strategy.list /
#   local.near.by.corner.info / idlemtopsearch.search.shade（整段推广位，拦了是功能裁剪）；
#   idlecommerce.adx.bid（三方竞价入口，拦掉可能退回非竞价瀑布流）；
#   idlecommerce.game.iaa.ads / rewardad（用户主动触发的激励视频）；
#   adash / adashx 埋点（拦掉不影响展示，但会丢归因）。

# 淘宝：TopShow 顶展、poplayer 配置、HEIC 开屏兜底（原先的 URL-REGEX 规则，改为按开关生效）
request if ${taobao_enable} == true && ${url} ~= /\/mtop\.alimama\.topshow\.query/ then reject(404)
request if ${taobao_enable} == true && ${url} ~= /\/mtop\.alimama\.topshow\.interact/ then reject(404)
request if ${taobao_enable} == true && ${url} ~= /\/mtop\.taobao\.poplayer\.xdsl/ then reject(404)
request if ${taobao_enable} == true && ${url} ~= /^https:\/\/heic\.alicdn\.com\/imgextra\/i[0-9]+\/[0-9]*\/?[A-Za-z0-9_!]+-[0-9]-(octopus|tps)-(1080|1125)-[0-9]{4}\.(jpg|png)/ then reject(404)

# 网易云音乐：广告接口（按开关生效）
request if ${netease_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*music\.163\.com\/[a-z]*api\/ad\/(loading|prefetch|get|flow|materialconfig|commonconfig|config|monitor|sniffing|start|device)/ then reject(404)
request if ${netease_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*music\.163\.com\/[a-z]*api\/(social\/event\/bff\/ad\/|ichat\/home\/ad\/list)/ then reject(404)
request if ${netease_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*music\.163\.com\/[a-z]*api\/delivery\/(batch-)?deliver/ then reject(404)
# eapi 直连 IP：关闭开关后不拦，避免影响正常播放
request if ${netease_enable} == true && ${url} ~= /^https?:\/\/ipv[46]\.music\.163\.com\// then reject(404)

# ══ 传输层：改写云配置禁用 HTTPDNS 与 QUIC ══
response if (${zhihu_enable} == true || ${zhihu_purify} == true) && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/api\/cloud\/zhihu\/config\/all/i then response.json.jq("def disabled_keys: {\"km_httpdns_new_config_tars\":true,\"preFetchHttpDns\":true,\"httpdns_detector_use_concurrent\":true,\"httpdns_use_memory_cache\":true,\"httpdns_new_config_tars\":true,\"tarsMixAb\":true,\"sugarQuicConfig\":true,\"quic_dns_detect_enable\":true,\"quicMixAB\":true,\"quic_downgrade_enable\":true,\"quic_priority_strategy\":true,\"quic_check_health_enable\":true,\"tquic_configuration\":true,\"networkExprimentList\":true,\"tars_ab_list\":true,\"zaSetExtraRequestHeader\":true}; def disable_dns: if type == \"object\" then if has(\"whiteHosts\") then .whiteHosts = [] else . end | if has(\"isDetectorClosed\") then .isDetectorClosed = 1 else . end | if has(\"isBackupIPClosed\") then .isBackupIPClosed = 1 else . end | if has(\"isDowngradeClosed\") then .isDowngradeClosed = 0 else . end | if has(\"dnsParser\") and (.dnsParser | type) == \"object\" then .dnsParser.httpdnsEnable = 0 else . end else . end; def disable_core_dns: if type == \"object\" then .ZHHttpDnsStartupItem_PreResolveHostsSample = \"0\" | .ZHSwitchHTTPDNSFunction_switchHTTPDNS = \"0\" | .ZHSwitchHTTPDNSFunction_switchHTTPDNSNew = {ratio: 0, whiteHosts: []} | .ZHBackUpIP_Switch_Open = \"0\" | .ZHBackUpIP_Detecter_Open = \"0\" | .ZHBackUpIPDetector_Open_backupipDetector = \"0\" | .LocalDNSSetHostWhiteList = [] else . end; if (.data.configs | type) == \"array\" then .data.configs |= map( if type != \"object\" then . elif .configKey == \"coreNetworkConf_useTars\" or .configKey == \"km_coreNetworkConf_useTars\" then .configValue |= disable_core_dns | .configVersion = \"20261024.03.30.00001\" elif (disabled_keys[.configKey // \"\"] // false) == true then .status = false | .configValue |= disable_dns | .configVersion = \"20261024.03.30.00001\" else . end) else . end")

# ══ 广告位 ══
# 14 个广告位接口，含开屏 launch_v2、按回答 ID 请求的 bottom-v2
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/commercial_api\//i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/ad-style-service\//i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/ad-track\//i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/adx\/third_sdk_info/i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/adEngine\//i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/fringe\/ad/i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/content-distribution-core\/bubble\/common\/show/i then reject_dict(200)

# 开屏与彩蛋：上面的 commercial_api 通拦已覆盖，这两条是显式冗余。
# 包内证据：commercial_api/launch_v2、real_time_launch_v2、sdk_launch；彩蛋走 search_eggs、pull_refresh_search_eggs。
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/commercial_api\/(?:launch_v2|real_time_launch_v2|sdk_launch)(?:[/?]|$)/i then reject_dict(200)
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/commercial_api\/(?:search_eggs|pull_refresh_search_eggs)(?:[/?]|$)/i then reject_dict(200)

# ══ 回答流 ══
request if ${zhihu_purify} == true && ${url} ~= /^(https?:\/\/(?:[a-z0-9-]+\.)*zhihu\.com\/(?:simple-)?next-render\?)(?=(?:[^&#]*&)*type=answer(?:&|$))((?:[^&#]*&)*scenes=)[^&#]*/i as answerFlow then url.replace("${answerFlow.1}${answerFlow.2}question")

# ══ 内容净化 ══
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/comment_v[0-9]+\/(answers|pins)\/[0-9]+\/root_comment/i then response.json.delete("atmosphere_voting_config")
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/comment_v[0-9]+\/(answers|articles|pins)\/[0-9]+\/list-headers/i then response.json.delete("continuous_consumption_module")
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/people\/self/i then response.json.jq("reduce [\"vip_info\", \"kvip_info\"][] as $key (.; if (.[$key] | type) == \"object\" then .[$key] |= with_entries(select(.key | startswith(\"entrance\") | not)) else . end)")

# 回答底部广告：/commercial_api/answer/{id}/bottom-v2 返回 {"adjson":"..."}
response if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api\/answer\/[0-9]+\/bottom-v2/i then response.json.delete("adjson")

# 回答底部品牌广告：PAG 素材走 zhstatic.zhihu.com/brand-ad/
request if ${zhihu_enable} == true && ${url} ~= /^https?:\/\/zhstatic\.zhihu\.com\/brand-ad\//i then reject(404)

# ══ 界面精简 ══
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/root\/tab(?:\/v[0-9]+)?/i then response.json.jq(".tab_list |= map(select(.tab_type == \"follow\" or .tab_type == \"recommend\" or .tab_type == \"hot\" or .tab_type == \"ring_tab\"))")
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/search\/tabs/i then response.json.jq(".data |= map(select(.t | IN(\"general\", \"ai_zhida\", \"recent\", \"people\", \"ring\", \"topic\", \"podcast\", \"column\", \"pin\", \"favlist\")))")

# ══ 推广位 ══
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/related_recommend\/feed\/waterfall/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/search\/preset_words/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/search\/related_queries\/question\/[0-9]+/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/api\/v[0-9]+\/members\/homepage_card/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/people\/homepage_entry_v[0-9]+/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/kvip\/right\/my_card/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/unlimited\/go\/my_card\/(?:v[0-9]+|all)(?:[/?]|$)/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhida\.zhihu\.com\/ai_ingress\/knowledge\/square\/categories\/feeds/i then reject_dict(200)
request if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhida\.zhihu\.com\/ai_ingress\/ai_chat\/guidance/i then reject_dict(200)

response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/search\/recommend_query\/v[0-9]+/i then response.json.jq(".recommend_queries.queries |= map(select(.type == \"normal\"))")
response if ${zhihu_purify} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/podcasts\/hub\/v[0-9]+/i then response.json.delete("banners")

# sugar.zhihu.com 兼作网络探活域（/check_health），故按路径拦而非整域

# [实验] 回答底部广告：page-info 可能是广告卡的注入源。
# 开启后若回答页空白/无法加载，立即注释回去；能正常看回答但底部广告消失就保留。
# request if ${zhihu_enable} == true && ${url} ~= /^https:\/\/page-info\.zhihu\.com\/(answers|articles)\/v2\//i then reject_dict(200)

# 哔咔：PicaWeb 的 Service Worker 会把导航喂成预缓存壳，注入进不去，先拒掉注册地址
request if ${pica_enable} == true && ${url} ~= /^https:\/\/(?:www\.)?manhuabika\.com\/(?:sw\.js|workbox-[^\/?#]+\.js)/ then reject(404)

# ══ 高德地图：开屏两条链路 ══
# 链路 1：阿里妈妈素材下发（池化）。com.autonavi.minimap.alimama.param.SplashScreenRequest#E
#   = ConfigerHelper.AOS_URL_KEY("aos_url" → https://m5.amap.com/) + "ws/valueadded/alimama/splash_screen"
#   冷启动 / 热切（scene 100/101/104/105/106/108/110、102/103）与 Wi-Fi 预取都走这条。
#   响应 {"code":"1"|"7","data":{"ad":[…]}}，data.ad 才是素材条目。
# 链路 2：实时「秒开」。URL 由云控 splashscreen.realtime_scene_config 下发，写到
#   https://amap-aos-info-nogw.amap.com/ws/aos/alimama/splash_screen_rt?ent=2
#   响应同样是 code + data，但素材在 data.custom_list[].creative[]，不是 ad（a.f 只读 custom_list）。
#
# 为什么用字段净化而不是 reject_dict：
#   com.autonavi.minimap.net.Callback#onSuccess 先看 code，只有 "1"/"7" 才往下走；
#   走成功分支的第一件事就是 remove("afp_splash_events") + dc2.m(null)——把本地开屏广告池
#   和实时条目一起清掉，再把 data.ad 解析成列表。返回空 ad 等于「服务端说今天没广告」，
#   池子被清空且不下载素材。reject_dict 走的是失败分支（invalid_resp），池子原样保留，
#   已下发的广告还会照播到 end_time，得手动清 App 缓存。字段净化把这一步省了。
#   code 用 "7"（客户端对 7 与 1 同等对待）；data 留空对象，实时链路找不到 custom_list
#   自然判定无素材，两条链路一个响应体够用。
response if ${amap_enable} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)*amap\.com\/ws\/valueadded\/alimama\/splash_screen/ then response.json.jq("{\"code\":\"7\",\"data\":{}}")
response if ${amap_enable} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)*amap\.com\/ws\/aos\/alimama\/splash_screen_rt/ then response.json.jq("{\"code\":\"7\",\"data\":{}}")

# 备选（不推荐）：reject_dict(200) 也能让开屏不出现，但不清本地池，旧素材会播到 end_time。
# request if ${amap_enable} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)*amap\.com\/ws\/valueadded\/alimama\/splash_screen/ then reject_dict(200)

# 不拦：ws/shield/dsp/app/startup/init（云控开关，含开屏频控与试验配置，拦了整个启动配置回退默认）、
#       ws/shield/frogserver/aocs/updatable/1（AOCS 云控，splashscreen 模块就在这里下发，
#       但响应结构带模块级 version/status，改写成本高且回退默认值反而更爱放广告）、
#       ws/banner/lists（首页 banner，不是开屏）、ws/device/adius/（设备 ID 上报）。

[Script]
request if ${netease_debug} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*music\.163\.com\/[a-z]*api\//i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/netease-debug.js?v=1.0.18", {${netease_debug}}) with tag="网易云音乐调试"

# 开屏图片与视频
response if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(wireless\.home\.splash\.awesome\.get|cloudvideo\.video\.query)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/Taobao-ads-clean.js?v=1.0.18", {${taobao_debug}}) with enable=${taobao_enable}, tag="淘宝开屏净化", requires_body=true

# 开屏活动（poplayer 远程模板）
response if ${url} ~= /^https:\/\/poplayer\.template\.alibaba\.com\/\w+\.json/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/Taobao-ads-clean.js?v=1.0.18", {${taobao_debug}}) with enable=${taobao_enable}, tag="淘宝开屏活动净化", requires_body=true

# 不拦：首页主数据 / 推荐流 / newface 首页 / 商品详情 / 购物车 / 订单 / 搜索 /
#       mtop 网关 / 会场 H5 / gw.alicdn.com 商品图 / dinamicx 弹窗模板


# 哔咔：PicaWeb 页面注入（路径无扩展名才可能是 SPA 的 HTML，assets 与接口不进脚本）
response if ${pica_enable} == true && ${url} ~= /^https?:\/\/(?:www\.)?(?:manhuabika\.com|picacomic\.com)\/+(?![^?#]*\.[a-z0-9]+(?:[?#]|$))/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/pica-clean.js?v=1.0.18", {${pica_enable}, ${pica_debug}}) with tag="哔咔去广告注入", requires_body=true

response if (${zhihu_enable} == true || ${zhihu_purify} == true) && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*zhihu\.com\/(?:api\/)?(?:search_v[0-9]+|topstory\/recommend|(?:simple-)?next-render|(?:v[0-9]+\/)?questions|(?:v[0-9]+\/)?(?:answers|articles|pins)(?:\/v[0-9]+)?\/[0-9]+)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/zhihu-clean.js?v=1.0.18", {${zhihu_enable}, ${zhihu_purify}, ${zhihu_debug}}) with tag="知乎内容净化", requires_body=true

# missav：页面注入。路径无扩展名才可能是文档，assets / fonts / 视频分片不进脚本
response if ${missav_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*(?:missav123\.com|missav\.(?:ws|ai|live))\/+(?![^?#]*\.[a-z0-9]+(?:[?#]|$))/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/missav-clean.js?v=1.0.18", {${missav_enable}, ${missav_debug}}) with tag="missav 去广告注入", requires_body=true

# JAV 站族：同一套判据铺一批站；新增站点只加域名，判据不用改
response if ${jav_enable} == true && ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*(?:18av\.mm-cg\.com|njav\.tv|123av\.com|javdb\.com|javbus\.com|jav321\.com|javgg\.net|supjav\.com|javlibrary\.com|avmoo\.com|tellme\.pw)\/+(?![^?#]*\.[a-z0-9]+(?:[?#]|$))/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/jav-clean.js?v=1.0.18", {${jav_enable}, ${jav_debug}}) with tag="JAV 站族去广告注入", requires_body=true
# 多邻国：插屏放不放由**账号档位**决定，不是广告接口，所以改写点是首方用户数据。
# 命中面只有 2023-05-23 的 batch（批量包裹：responses[] 内 body 可能是字符串也可能是对象，
# 且带 etag 的那条必须原样放行，否则条件请求会污染缓存）与 users/{id}（裸 userdata）。
# 只改三处：shopItems 补 gold_subscription、subscriberLevel 置 GOLD、trackingProperties.has_item_*_subscription 全开。
response if ${duolingo_enable} == true && ${url} ~= /^https?:\/\/(?:ios-api-[a-z0-9-]+|api\d+)\.duolingo\.c(?:n|om)\/2023-05-23\/(?:batch|users\/[^\/?#]+)(?:[?#]|$)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/duolingo-clean.js?v=1.0.18", {${duolingo_enable}, ${duolingo_debug}}) with tag="多邻国去广告", requires_body=true

# 判据诊断（Debug）：上面改完仍出插屏，说明判据不在资格层。本行只把候选**键名**打到日志，不落值。
response if ${duolingo_debug} == true && ${url} ~= /^https?:\/\/(?:ios-api-[a-z0-9-]+|api\d+)\.duolingo\.c(?:n|om)\/2023-05-23\/(?:batch|users\/[^\/?#]+)(?:[?#]|$)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/duolingo-dump.js?v=1.0.18", {${duolingo_debug}}) with tag="多邻国判据诊断", requires_body=true


# 闲鱼：广告接口诊断（仅 Debug 构建）。XYDEBUG 请求行 / XYDUMP 完整响应 / XYFEED 卡片结构
request if ${xianyu_debug} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlecommerce\.(splash(?:\.async)?\.ads|adx\.bid|game\.iaa\.ads)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/xianyu-debug.js?v=1.0.18", {${xianyu_debug}}) with tag="闲鱼请求诊断"
response if ${xianyu_debug} == true && ${url} ~= /\/gw\/mtop\.taobao\.idlecommerce\.(splash(?:\.async)?\.ads|adx\.bid|game\.iaa\.ads)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/xianyu-dump.js?v=1.0.18", {${xianyu_debug}}) with tag="闲鱼响应抓取", requires_body=true
response if ${xianyu_debug} == true && ${url} ~= /\/gw\/mtop\.(?:taobao\.idle(?:\.home)?\.(?:firstdata|nextfresh|nextnearby)|taobao\.idlehome\.home\.nextfresh|alimama\.zz\.ad\.get)/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/xianyu-feed-probe.js?v=1.0.18", {${xianyu_debug}}) with tag="闲鱼信息流探针", requires_body=true

# 高德：开屏接口诊断。iOS 取不到可解密样本，开屏到底走哪台 AOS 主机只能靠抓一次启动回答；
# 日志里 AMDEBUG 行的主机名决定 [MITM] 要不要补，AMDUMP-* 是响应体。
response if ${amap_debug} == true && ${url} ~= /\/ws\/(?:valueadded|aos)\/alimama\/splash_screen/i then script("https://cdn.jsdelivr.net/gh/RedContritio/RedCognitio-Ads-Rule@main/dist/debug/scripts/amap-dump.js?v=1.0.18", {${amap_debug}}) with tag="高德开屏诊断", requires_body=true

[MITM]
hostname = zhihu.com, *.zhihu.com, taobao.com, *.taobao.com, *.tmall.com, heic.alicdn.com, poplayer.template.alibaba.com, music.163.com, *.music.163.com, ipv4.music.163.com, ipv6.music.163.com, manhuabika.com, *.manhuabika.com, picacomic.com, www.picacomic.com, m5.amap.com, m5-x.amap.com, amap-aos-info-nogw.amap.com, goofish.com, *.goofish.com, missav.ws, *.missav.ws, missav123.com, *.missav123.com, missav.ai, *.missav.ai, missav.live, *.missav.live, 18av.mm-cg.com, *.18av.mm-cg.com, njav.tv, *.njav.tv, 123av.com, *.123av.com, javdb.com, *.javdb.com, javbus.com, *.javbus.com, jav321.com, *.jav321.com, javgg.net, *.javgg.net, supjav.com, *.supjav.com, javlibrary.com, *.javlibrary.com, avmoo.com, *.avmoo.com, tellme.pw, ios-api.duolingo.com, ios-api-1.duolingo.com, ios-api-2.duolingo.com, ios-api-cf.duolingo.com, api.duolingo.com, api2.duolingo.com, ios-api-2.duolingo.cn
