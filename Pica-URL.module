#!name=哔咔漫画 去广告（需 MITM）
#!desc=哔咔广告拦截（PicaWeb + iOS 原生）：封自建广告服务器；PicaWeb 另注入样式并在阅读器自动翻过每 21 页的广告页。需 MITM，Loon 3.5.1+
#!category=广告拦截
#!author=RedContritio
#!homepage=https://github.com/RedContritio/RedCognitio-Ads-Rule
#!version=0.2.0
#!date=2026-10-29 · 0.2.0
#!loon_version=3.5.1(983)
#
# Copyright 2026 RedContritio
# SPDX-License-Identifier: Apache-2.0
#
# 范围：只做去广告。公告、推荐位、分类与标签、评论、章节列表都不动。
# 两个端：iOS 原生客户端（Flutter）只吃 [Rule] 段；[Script] 注入只服务 PicaWeb。

[Argument]
pica_enable = switch,true,type=boolean,tag=哔咔-去广告,desc=注入去广告样式并跳过阅读器广告页
pica_debug = switch,false,type=boolean,tag=哔咔-调试,desc=记录注入命中与跳过注入的原因

[Rule]
# QUIC 无法 MITM。Cloudflare 对 h3 有 Alt-Svc，浏览器用上 h3 后注入静默失效，故先拦 QUIC。
AND,((DOMAIN-SUFFIX,manhuabika.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,picacomic.com),(PROTOCOL,QUIC)),REJECT

# 广告服务器，域名固定（Cloudflare），不随 API 域名轮换：
#   /get-ad-zones  广告位下发（瀑布流四组 zone 组合 + 首页横幅一组）
#   /redirect/{z}  点击跳转
#   /medias/*      创意素材 gif / mp4
#   /android/*     内嵌 H5 广告页（font / comic_detail / chat / cat）
# API 域名会换成 go2778.com、acbbb.com 等（那是图片 CDN），广告域不跟着换，只封这一个。
# iOS 原生客户端（com.picacomic.picacg.picacg，Flutter）的 AdRemoteDataSource 拼的也是这个域。
DOMAIN-SUFFIX,diwodiwo.xyz,REJECT,extended-matching,pre-matching

# 旧版 Android 客户端的 H5 广告位宿主；2026-10-29 实测已不响应，
# 服务端由 /api/v1/init 的 waka 字段下发新地址，保留此条防回切。
DOMAIN,pica-juicy.picacomic.com,REJECT,extended-matching,pre-matching

# 兜底：iOS 端把广告域写成前缀形式 https://pica-ad-api.<domain>，
# 换域时下面这条仍能命中（当前实测就是 pica-ad-api.diwodiwo.xyz）
DOMAIN-KEYWORD,pica-ad-api,REJECT,extended-matching,pre-matching

[Rewrite]
# PicaWeb 是 PWA：sw.js（Workbox）把所有导航都喂成预缓存的 index.html，注入进不到页面；
# 广告 gif 又按 CacheFirst 存 30 天。脚本里会注销 SW 并清缓存，这里再拒一次注册地址。
request if ${pica_enable} == true && ${url} ~= /^https:\/\/(?:www\.)?manhuabika\.com\/(?:sw\.js|workbox-[^\/?#]+\.js)/ then reject(404)

[Script]
# 只对「不像静态资源」的页面请求注入：路径里没有扩展名才可能是 SPA 的 HTML。
# 接口、locale JSON、assets 下的 js/css/图片都不进脚本，免得白拉响应体。
response if ${pica_enable} == true && ${url} ~= /^https?:\/\/(?:www\.)?(?:manhuabika\.com|picacomic\.com)\/+(?![^?#]*\.[a-z0-9]+(?:[?#]|$))/i then script("https://raw.githubusercontent.com/RedContritio/RedCognitio-Ads-Rule/main/scripts/pica-clean.js?v=0.2.0", {${pica_enable}, ${pica_debug}}) with tag="哔咔去广告注入", requires_body=true

[MITM]
hostname = manhuabika.com, *.manhuabika.com, picacomic.com, www.picacomic.com
